<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Starting splash theme extending Theme.SplashScreen -->
    <style name="Theme.LocalVault.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen (auto switches for light/dark) -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Centered splash icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>

        <!-- Theme to switch to once splash screen is dismissed -->
        <item name="postSplashScreenTheme">@style/Theme.LocalVault</item>
    </style>
</resources>
